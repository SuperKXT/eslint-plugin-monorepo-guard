{
	"name": "eslint-plugin-monorepo-guard",
	"description": "ESLint rules to enforce package boundaries in a monorepo",
	"version": "0.0.3",
	"author": "Saad Khan",
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/node": "25.7.0",
		"@typescript-eslint/parser": "8.59.3",
		"@vitest/eslint-plugin": "1.6.17",
		"cspell": "10.0.0",
		"eslint": "10.3.0",
		"eslint-import-resolver-typescript": "4.4.4",
		"eslint-plugin-eslint-plugin": "7.3.3",
		"eslint-plugin-import-x": "4.16.2",
		"eslint-plugin-n": "18.0.1",
		"eslint-plugin-only-warn": "1.2.1",
		"eslint-plugin-unused-imports": "4.4.1",
		"globals": "17.6.0",
		"prettier": "3.8.3",
		"syncpack": "15.1.2",
		"tsup": "8.5.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.59.3",
		"vitest": "4.1.6"
	},
	"engines": {
		"node": "^18.18.0 || ^20.9.0 || >=21.1.0"
	},
	"exports": {
		".": {
			"import": {
				"types": "./build/index.d.ts",
				"default": "./build/index.js"
			},
			"require": {
				"types": "./build/index.d.cts",
				"default": "./build/index.cjs"
			}
		}
	},
	"files": [
		"build"
	],
	"keywords": [
		"eslint",
		"eslint-plugin",
		"eslintplugin",
		"imports",
		"lerna",
		"monorepo",
		"nx",
		"package",
		"plugin",
		"pnpm",
		"relative",
		"turbo",
		"turborepo",
		"workspaces",
		"yarn"
	],
	"license": "MIT",
	"main": "./build/index.cjs",
	"packageManager": "pnpm@11.1.0",
	"peerDependencies": {
		"eslint": ">=9.0.0 <11.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/SuperKXT/eslint-plugin-monorepo-guard"
	},
	"scripts": {
		"build": "tsup",
		"format": "syncpack format && prettier --write --log-level silent .",
		"lint": "eslint . --max-warnings=0 --fix && pnpm format && pnpm spellcheck",
		"lint-ci": "syncpack format --check && pnpm spellcheck && prettier --check . && tsc && pnpm typecheck && pnpm test && eslint --max-warnings=0 *.{js,cjs,ts} && pnpm build",
		"prepublishOnly": "pnpm typecheck && pnpm build && pnpm test",
		"spellcheck": "cspell . --quiet",
		"test": "vitest run",
		"test:watch": "vitest",
		"tsc": "tsc",
		"typecheck": "tsc --noEmit"
	},
	"type": "module",
	"types": "./build/index.d.ts"
}
